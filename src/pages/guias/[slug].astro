---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const guias = await getCollection('guias');
  return guias.map((g) => ({
    params: { slug: g.id },
    props: { guia: g },
  }));
}

const { guia } = Astro.props;
const { Content } = await render(guia);
const { title, description, updatedAt, howto, sources } = guia.data;

const howtoJson = howto
  ? {
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: howto.name,
      description,
      step: howto.steps.map((s, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: s.name,
        text: s.text,
      })),
    }
  : null;

const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Guías', item: `${site.url}/guias/como-sacar-brevete-a-i` },
    { '@type': 'ListItem', position: 3, name: title, item: new URL(Astro.url.pathname, site.url).href },
  ],
};
---

<BaseLayout title={title} description={description} type="article">
  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Guías', href: '/guias/como-sacar-brevete-a-i' },
      { label: title },
    ]}
  />

  <article class="container-page pb-16">
    <header class="max-w-3xl">
      <p class="text-sm text-ink-muted">Guía · Actualizado {updatedAt}</p>
      <h1 class="mt-2 font-display text-4xl font-bold text-ink">{title}</h1>
      <p class="mt-3 text-lg text-ink-muted">{description}</p>
    </header>

    <div class="prose-guide mt-8">
      <Content />
    </div>

    <aside class="mt-12 max-w-3xl rounded-xl border border-line bg-surface-elevated p-5">
      <p class="font-semibold text-ink">Sigue practicando</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/simulacro/a-i">Simulacro A-I</a></li>
        <li><a href="/practica/senales">Práctica por tema</a></li>
        <li><a href="/repaso">Repaso de errores</a></li>
      </ul>
    </aside>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />
  {howtoJson && <script type="application/ld+json" set:html={JSON.stringify(howtoJson)} />}
</BaseLayout>
