---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import ExamApp from '../../components/quiz/ExamApp';
import { categorias, getCategoria } from '../../data/categorias';
import { getBank } from '../../lib/questions';
import { site } from '../../config/site';
import { breadcrumbSchema, quizSchema } from '../../lib/schema';

export function getStaticPaths() {
  return categorias.map((c) => ({ params: { categoria: c.slug } }));
}

const { categoria } = Astro.params;
const cat = getCategoria(categoria!);
if (!cat) throw new Error('Categoría no encontrada');

const questions = getBank(cat.slug).map((q) => ({
  id: q.id,
  categoria: q.categoria,
  tema: q.tema,
  enunciado: q.enunciado,
  opciones: q.opciones,
  correcta: q.correcta,
  imagen: q.imagen,
  explicacion: q.explicacion,
  slug: q.slug,
  publish: q.publish,
}));
---

<BaseLayout
  title={`Simulacro ${cat.codigo}: examen de reglas de tránsito`}
  description={`Simulacro gratuito de ${site.examRules.questionCount} preguntas para la categoría ${cat.codigo}. ${cat.descripcionCorta}`}
>
  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Simulacro', href: '/simulacro/a-i' },
      { label: cat.codigo },
    ]}
  />

  <section class="container-page pb-14">
    <div class="quiz-shell">
      <h1 class="heading-section">Simulacro {cat.codigo}</h1>
      <p class="text-body mt-3">{cat.evalua}</p>
      <p class="text-support mt-3">
        Formato de práctica: {site.examRules.questionCount} preguntas · umbral de referencia{' '}
        {site.examRules.passScore} · temporizador opcional de {site.examRules.timeLimitMinutes}{' '}
        minutos.{' '}
        <a href={site.examRules.sourceUrl} target="_blank" rel="noopener noreferrer">Fuente</a>
      </p>

      <div class="mt-8">
        <ExamApp
          client:load
          questions={questions}
          categoria={cat.codigo}
          passScore={site.examRules.passScore}
          timeLimitMinutes={site.examRules.timeLimitMinutes}
        />
      </div>
    </div>
  </section>

  <JsonLd
    data={[
      quizSchema({
        name: `Simulacro ${cat.codigo}`,
        description: cat.evalua,
        url: new URL(Astro.url.pathname, site.url).href,
        educationalLevel: cat.codigo,
      }),
      breadcrumbSchema([
        { name: 'Inicio', url: site.url },
        { name: 'Simulacro', url: `${site.url}/simulacro/a-i` },
        { name: cat.codigo, url: new URL(Astro.url.pathname, site.url).href },
      ]),
    ]}
  />
</BaseLayout>
