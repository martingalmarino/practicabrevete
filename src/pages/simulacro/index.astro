---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { categorias } from '../../data/categorias';
import { breadcrumbSchema } from '../../lib/schema';
import { absoluteUrl } from '../../lib/urls';
---

<BaseLayout
  title="Simulacros del examen de reglas por categoría"
  description="Simulacros gratuitos del examen de reglas de tránsito del MTC para todas las categorías de licencia. Practica con preguntas del balotario oficial."
>
  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Simulacros' },
    ]}
  />

  <section class="container-page pb-16">
    <div class="mx-auto max-w-4xl">
      <h1 class="heading-section">Simulacros del examen de reglas</h1>
      <p class="text-body mt-4 leading-relaxed">
        El examen de conocimientos tiene <strong>40 preguntas</strong>, se aprueba con <strong>35 correctas</strong> y dura <strong>40 minutos</strong>, según la directiva de evaluación del MTC. Practica aquí con el balotario oficial de tu categoría.
      </p>

      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        {categorias.map((cat) => {
          const isDisponible = cat.disponible;
          return (
            <article class="card-surface overflow-hidden p-0">
              <div class="border-b border-border bg-bg px-5 py-4">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="text-sm font-bold text-brand">{cat.codigo}</p>
                    <p class="mt-1 text-base font-semibold text-ink">{cat.nombre}</p>
                  </div>
                  {isDisponible && (
                    <span class="inline-flex rounded-full bg-success-soft px-2.5 py-1 text-xs font-semibold text-success">
                      Disponible
                    </span>
                  )}
                  {!isDisponible && (
                    <span class="inline-flex rounded-full bg-border px-2.5 py-1 text-xs font-semibold text-ink-muted">
                      En preparación
                    </span>
                  )}
                </div>
              </div>
              <div class="p-5">
                <p class="text-sm text-ink-muted">{cat.descripcionCorta}</p>
                {isDisponible && (
                  <a
                    href={`/simulacro/${cat.slug}/`}
                    class="btn-primary mt-4 w-full"
                  >
                    Empezar simulacro
                  </a>
                )}
                {!isDisponible && (
                  <button
                    type="button"
                    class="btn-secondary mt-4 w-full cursor-not-allowed opacity-60"
                    disabled
                  >
                    Próximamente
                  </button>
                )}
              </div>
            </article>
          );
        })}
      </div>

      <div class="mt-10 rounded-[12px] border border-border bg-bg p-6">
        <p class="text-sm font-semibold text-ink">Acerca de estos simulacros</p>
        <p class="mt-2 text-sm leading-relaxed text-ink-muted">
          Los bancos de preguntas provienen de los balotarios oficiales publicados por el Ministerio de Transportes y Comunicaciones (MTC). Este sitio es una plataforma independiente de preparación y <strong>no es oficial del Estado</strong>. El examen real lo administra el MTC a través de las municipalidades autorizadas.
        </p>
        <p class="mt-3 text-sm text-ink-muted">
          <a href="https://portal.mtc.gob.pe/transportes/terrestre/documentos/RD_Topicos_evaluacion_de_conocimientos.pdf" target="_blank" rel="noopener noreferrer" class="text-brand hover:underline">
            Directiva de evaluación del MTC
          </a>
          {' · '}
          <a href="https://sierdgtt.mtc.gob.pe/" target="_blank" rel="noopener noreferrer" class="text-brand hover:underline">
            Simulador oficial del MTC
          </a>
        </p>
      </div>
    </div>
  </section>

  <JsonLd
    data={[
      breadcrumbSchema([
        { name: 'Inicio', url: absoluteUrl('/') },
        { name: 'Simulacros', url: absoluteUrl('/simulacro/') },
      ]),
    ]}
  />
</BaseLayout>
