---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import ReviewApp from '../components/quiz/ReviewApp';
import { getAllQuestions } from '../lib/questions';

const questions = getAllQuestions().map((q) => ({
  id: q.id,
  categoria: q.categoria,
  tema: q.tema,
  enunciado: q.enunciado,
  opciones: q.opciones,
  correcta: q.correcta,
  imagen: q.imagen,
  explicacion: q.explicacion,
  slug: q.slug,
}));
---

<BaseLayout
  title="Repaso de errores"
  description="Repasa las preguntas que fallaste. Se guardan solo en tu dispositivo, sin crear cuenta."
>
  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Repaso de errores' }]} />
  <section class="container-page pb-14">
    <div class="quiz-shell">
      <h1 class="heading-section">Repaso de errores</h1>
      <p class="text-body mt-3">
        Tus fallos se guardan en este navegador. No enviamos tus respuestas a ningún servidor.
      </p>
      <div class="mt-8">
        <ReviewApp client:load questions={questions} />
      </div>
    </div>
  </section>
</BaseLayout>
