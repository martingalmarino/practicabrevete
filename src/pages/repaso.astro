---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import ReviewApp from '../components/quiz/ReviewApp';
import { getAllQuestions } from '../lib/questions';

const questions = getAllQuestions().map((q) => ({
  id: q.id,
  categoria: q.categoria,
  tema: q.tema,
  enunciado: q.enunciado,
  opciones: q.opciones,
  correcta: q.correcta,
  imagen: q.imagen,
  explicacion: q.explicacion,
  slug: q.slug,
}));
---

<BaseLayout
  title="Repaso de errores"
  description="Repasa las preguntas que fallaste. Se guardan solo en tu dispositivo, sin crear cuenta."
>
  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Repaso de errores' }]} />
  <section class="container-page pb-12">
    <h1 class="font-display text-3xl font-bold text-ink">Repaso de errores</h1>
    <p class="mt-3 max-w-2xl text-ink-muted">
      Tus fallos se guardan en localStorage de este navegador. No enviamos tus respuestas a ningún servidor.
    </p>
    <div class="mt-8">
      <ReviewApp client:load questions={questions} />
    </div>
  </section>
</BaseLayout>
