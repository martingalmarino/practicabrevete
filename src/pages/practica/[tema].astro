---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import PracticeApp from '../../components/quiz/PracticeApp';
import { temas, getTema } from '../../data/temas';
import { getQuestionsByTema } from '../../lib/questions';
import type { TemaId } from '../../data/tipos';

export function getStaticPaths() {
  return temas.map((t) => ({ params: { tema: t.slug } }));
}

const { tema } = Astro.params;
const t = getTema(tema!);
if (!t) throw new Error('Tema no encontrado');

const questions = getQuestionsByTema(t.slug as TemaId).map((q) => ({
  id: q.id,
  categoria: q.categoria,
  tema: q.tema,
  enunciado: q.enunciado,
  opciones: q.opciones,
  correcta: q.correcta,
  imagen: q.imagen,
  explicacion: q.explicacion,
  slug: q.slug,
}));
---

<BaseLayout
  title={`Práctica: ${t.nombre}`}
  description={`${t.descripcion} Feedback inmediato y explicación en cada respuesta.`}
>
  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Practicar', href: '/practica/senales' },
      { label: t.nombre },
    ]}
  />

  <section class="container-page pb-14">
    <div class="quiz-shell">
      <h1 class="heading-section">Práctica: {t.nombre}</h1>
      <p class="text-body mt-3">{t.descripcion}</p>
      <p class="text-support mt-2">
        {questions.length} preguntas en este tema (categoría A-I). Elige, confirma y luego revisa la
        explicación.
      </p>

      <div class="mt-8">
        <PracticeApp client:load questions={questions} tema={t.slug} temaNombre={t.nombre} />
      </div>
    </div>
  </section>
</BaseLayout>
