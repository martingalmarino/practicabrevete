---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import PracticeApp from '../../components/quiz/PracticeApp';
import { temas, getTema } from '../../data/temas';
import { getQuestionsByTema } from '../../lib/questions';
import type { TemaId } from '../../data/tipos';

export function getStaticPaths() {
  return temas.map((t) => ({ params: { tema: t.slug } }));
}

const { tema } = Astro.params;
const t = getTema(tema!);
if (!t) throw new Error('Tema no encontrado');

const questions = getQuestionsByTema(t.slug as TemaId).map((q) => ({
  id: q.id,
  categoria: q.categoria,
  tema: q.tema,
  enunciado: q.enunciado,
  opciones: q.opciones,
  correcta: q.correcta,
  imagen: q.imagen,
  explicacion: q.explicacion,
  slug: q.slug,
}));
---

<BaseLayout
  title={`Práctica: ${t.nombre}`}
  description={`${t.descripcion} Feedback inmediato y explicación en cada respuesta.`}
>
  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Práctica', href: '/practica/senales' },
      { label: t.nombre },
    ]}
  />

  <section class="container-page pb-12">
    <h1 class="font-display text-3xl font-bold text-ink">Práctica: {t.nombre}</h1>
    <p class="mt-3 max-w-3xl text-ink-muted">{t.descripcion}</p>
    <p class="mt-3 max-w-3xl text-sm leading-relaxed text-ink-muted">
      En este modo recibes feedback inmediato y puedes abrir la explicación tras cada respuesta. El
      progreso se guarda solo en tu navegador. Combina tandas cortas aquí con un
      <a href="/simulacro/a-i">simulacro completo</a> cuando quieras medir el umbral de aprobación.
      Si el tema se te resiste, revisa también las
      <a href="/guias/errores-comunes-examen">guías de errores comunes</a>.
    </p>
    <p class="mt-2 text-sm text-ink-muted">{questions.length} preguntas en este tema (categoría A-I).</p>

    <div class="mt-8">
      <PracticeApp client:load questions={questions} tema={t.slug} temaNombre={t.nombre} />
    </div>
  </section>
</BaseLayout>
