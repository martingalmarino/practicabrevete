---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicIcon from '../components/ui/TopicIcon.astro';
import DemoPracticeMini from '../components/home/DemoPracticeMini.astro';
import DemoExamMini from '../components/home/DemoExamMini.astro';
import DemoReviewMini from '../components/home/DemoReviewMini.astro';
import ExplanationPreview from '../components/home/ExplanationPreview.astro';
import StageSimulacro from '../components/home/StageSimulacro.astro';
import StageRepaso from '../components/home/StageRepaso.astro';
import { site } from '../config/site';
import { temas } from '../data/temas';
import { getPublishedQuestions } from '../lib/questions';

/** Pregunta corta del banco para el preview estático de explicaciones */
const explanationExample =
  getPublishedQuestions().find((q) => q.id === 'a-i-012') ?? getPublishedQuestions()[0];

const faqs = [
  {
    q: '¿Cuántas preguntas tiene el examen de brevete?',
    a: `El examen de reglas de tránsito tiene ${site.examRules.questionCount} preguntas de selección múltiple. Para aprobar necesitas al menos ${site.examRules.passScore} correctas, según la orientación publicada en gob.pe.`,
  },
  {
    q: '¿Cuánto tiempo dura el examen de reglas de tránsito?',
    a: `La prueba oficial dura hasta ${site.examRules.timeLimitMinutes} minutos. En nuestro simulacro puedes activar o desactivar el temporizador.`,
  },
  {
    q: '¿Las preguntas son las del balotario oficial?',
    a: 'Sí: el banco se construye a partir de los PDFs públicos de balotarios publicados en gob.pe. Las explicaciones las redactamos nosotros y las marcamos como “revisar” hasta validarlas.',
  },
  {
    q: '¿Este sitio es oficial?',
    a: 'No. Practica Brevete es una plataforma independiente de preparación. No representamos a ninguna entidad del Estado ni usamos logos oficiales.',
  },
  {
    q: '¿Necesito crear una cuenta?',
    a: 'No. El progreso y el repaso de errores se guardan solo en tu navegador (localStorage), en este dispositivo.',
  },
  {
    q: '¿El simulacro es gratis?',
    a: 'Sí. Puedes practicar sin pagar y sin crear una cuenta.',
  },
];

const guias = [
  {
    href: '/guias/como-sacar-brevete-a-i',
    title: 'Cómo sacar el brevete A-I',
    desc: 'Orden general del trámite, requisitos tipicos y enlaces a fuentes oficiales.',
    label: 'Proceso',
  },
  {
    href: '/guias/senales-de-transito',
    title: 'Señales de tránsito explicadas',
    desc: 'Reglamentarias, semáforos y marcas viales con foco en el examen.',
    label: 'Señales',
  },
  {
    href: '/guias/prioridad-de-paso-y-rotondas',
    title: 'Prioridad de paso y rotondas',
    desc: 'Quién pasa primero en cruces, emergencias y glorietas.',
    label: 'Prioridad',
  },
  {
    href: '/guias/errores-comunes-examen',
    title: 'Errores más comunes',
    desc: 'Fallos frecuentes y cómo corregirlos con práctica deliberada.',
    label: 'Examen',
  },
  {
    href: '/guias/como-estudiar-en-7-dias',
    title: 'Cómo estudiar en 7 días',
    desc: 'Plan semanal con simulacros, temas y repaso de errores.',
    label: 'Estudio',
  },
  {
    href: '/guias/examen-de-manejo-practico',
    title: 'Examen de manejo práctico',
    desc: 'En qué fijarse además del teórico de reglas de tránsito.',
    label: 'Práctico',
  },
];

const [guiaDestacada, ...guiasSecundarias] = guias;

const reviewDate = new Date(`${site.lastContentReview}T12:00:00`).toLocaleDateString('es-PE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${site.name}: simulador del examen de reglas de tránsito`}
  description={site.description}
>
  <!-- SECTION 1: Hero + feature cards -->
  <section class="bg-soft pb-12 pt-12 lg:pb-20 lg:pt-16">
    <div class="container-wide">
      <div class="mx-auto max-w-[720px] text-center">
        <p class="badge">Practica Brevete · Perú</p>
        <h1 class="heading-hero mt-4">Prepárate para tu examen de reglas de tránsito</h1>
        <p class="text-body mx-auto mt-4 max-w-xl sm:text-lg">
          Practica por temas, pon a prueba lo que sabes y aprende de tus errores.
        </p>
        <div class="mt-6 flex flex-col items-center gap-3">
          <a href="/simulacro/a-i" class="btn-primary">Empezar simulacro A-I</a>
          <a href="#temas" class="btn-text">Explorar temas</a>
          <p class="text-support">Sin registro</p>
        </div>
      </div>

      <ul class="mt-10 grid gap-5 md:mt-12 md:grid-cols-3 md:gap-6">
        <li class="h-full">
          <a href="/practica/senales" class="feature-card bg-cyan text-ink">
            <h2 class="feature-card-title">Practicar por tema</h2>
            <p class="feature-card-desc text-ink/80">Refuerza un tema con feedback.</p>
            <DemoPracticeMini />
          </a>
        </li>
        <li class="h-full">
          <a href="/simulacro/a-i" class="feature-card bg-violet text-white">
            <h2 class="feature-card-title text-white">Simulacro</h2>
            <p class="feature-card-desc text-white/85">Evalúa tu preparación completa.</p>
            <DemoExamMini />
          </a>
        </li>
        <li class="h-full">
          <a href="/repaso" class="feature-card bg-yellow text-ink" id="home-repaso-card">
            <h2 class="feature-card-title">Repasar errores</h2>
            <p class="feature-card-desc text-ink/80" id="home-repaso-desc">
              Vuelve sobre lo que necesitas mejorar.
            </p>
            <DemoReviewMini />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- SECTION 2: Entiende cada respuesta -->
  <section class="section-y bg-surface">
    <div class="mx-auto grid w-full max-w-[1040px] items-center gap-8 px-5 md:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-12">
      <div class="feature-copy">
        <h2 class="heading-section">Entiende cada respuesta</h2>
        <p class="text-body">
          Practica con preguntas del banco disponible y revisa las explicaciones publicadas para
          comprender en qué puedes mejorar.
        </p>
        <a href="/practica/senales" class="btn-primary">Practicar por tema</a>
      </div>
      <div class="w-full max-w-[480px] justify-self-stretch rounded-[24px] bg-cyan p-6 lg:justify-self-end">
        {
          explanationExample ? (
            <ExplanationPreview
              enunciado={explanationExample.enunciado}
              respuestaCorrecta={explanationExample.opciones[explanationExample.correcta]}
              explicacion={explanationExample.explicacion?.texto}
              imagen={explanationExample.imagen}
            />
          ) : (
            <div class="rounded-[16px] border border-border bg-surface p-6 shadow-[var(--shadow-soft)]">
              <p class="text-sm font-semibold text-ink-muted">Ejemplo de explicación</p>
              <p class="mt-3 text-body">Elige un tema para practicar con feedback.</p>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- SECTION 3: Simulacro -->
  <section class="section-y bg-surface pt-0 lg:pt-0">
    <div class="feature-section">
      <div class="order-1 feature-copy lg:order-2">
        <h2 class="heading-section">Pon a prueba lo que sabes</h2>
        <p class="text-body">
          Realiza un simulacro y revisa tus resultados para identificar qué temas necesitas reforzar.
        </p>
        <a href="/simulacro/a-i" class="btn-primary">Empezar simulacro</a>
      </div>
      <div class="order-2 w-full lg:order-1">
        <StageSimulacro />
      </div>
    </div>
  </section>

  <!-- SECTION 4: Errores -->
  <section class="bg-lavender">
    <div class="section-y">
      <div class="feature-section">
        <div class="feature-copy">
          <h2 class="heading-section">Convierte tus errores en aprendizaje</h2>
          <p class="text-body">
            Vuelve a las preguntas que necesitas reforzar y sigue practicando a tu ritmo.
          </p>
          <a href="/repaso" class="btn-primary" id="home-repaso-cta">Repasar mis errores</a>
          <p class="text-support" id="home-repaso-hint">
            Si aún no tienes errores guardados, puedes empezar practicando por tema.
          </p>
        </div>
        <div class="w-full">
          <StageRepaso />
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: Temas -->
  <section id="temas" class="section-y bg-surface">
    <div class="container-page">
      <h2 class="heading-section text-center">¿Qué tema quieres practicar?</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          temas.map((t) => (
            <li>
              <a href={`/practica/${t.slug}`} class="topic-card group">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[var(--radius-sm)] bg-soft text-brand">
                  <TopicIcon name={t.icon} />
                </span>
                <span class="min-w-0">
                  <span class="block text-base font-bold text-ink group-hover:text-brand">{t.nombre}</span>
                  <span class="mt-1.5 block text-sm leading-relaxed text-ink-muted">{t.descripcion}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- SECTION 6: Guías -->
  <section class="section-y bg-soft">
    <div class="container-page">
      <h2 class="heading-section">Guías para preparar tu brevete</h2>
      <p class="text-body mt-4 max-w-2xl">
        Lecturas propias, con respuesta directa al inicio y fuentes citadas.
      </p>

      <div class="mt-8 space-y-4">
        <a
          href={guiaDestacada.href}
          class="card-surface flex flex-col gap-3 p-6 no-underline transition-shadow hover:shadow-[var(--shadow-soft)] hover:no-underline sm:flex-row sm:items-center sm:justify-between sm:gap-8 sm:p-7"
        >
          <span class="min-w-0">
            <span class="badge-accent">{guiaDestacada.label}</span>
            <h3 class="mt-2 text-xl font-extrabold tracking-tight text-ink sm:text-2xl">
              {guiaDestacada.title}
            </h3>
            <p class="text-body mt-2 max-w-xl">{guiaDestacada.desc}</p>
          </span>
          <span class="shrink-0 text-sm font-bold text-brand">Leer →</span>
        </a>

        <ul class="overflow-hidden rounded-[var(--radius-md)] border border-border bg-surface divide-y divide-border">
          {
            guiasSecundarias.map((g) => (
              <li>
                <a
                  href={g.href}
                  class="group flex flex-col gap-2 px-5 py-5 no-underline hover:bg-white hover:no-underline sm:flex-row sm:items-center sm:justify-between sm:gap-6"
                >
                  <span class="min-w-0">
                    <span class="badge-accent">{g.label}</span>
                    <span class="mt-1 block text-base font-bold text-ink group-hover:text-brand">{g.title}</span>
                    <span class="mt-1 block text-sm leading-relaxed text-ink-muted">{g.desc}</span>
                  </span>
                  <span class="shrink-0 text-sm font-bold text-brand">Leer →</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- SECTION 7: FAQ + trust -->
  <section class="section-y bg-surface">
    <div class="container-narrow">
      <h2 class="heading-section text-center">Preguntas frecuentes</h2>
      <div class="mt-8 divide-y divide-border overflow-hidden rounded-[var(--radius-md)] border border-border bg-surface">
        {
          faqs.map((f, i) => (
            <div>
              <button
                type="button"
                class="faq-trigger flex min-h-12 w-full items-center justify-between gap-4 px-5 py-4 text-left text-base font-bold text-ink"
                aria-expanded="false"
                aria-controls={`faq-panel-${i}`}
                id={`faq-btn-${i}`}
              >
                <span>{f.q}</span>
                <svg class="faq-chevron h-5 w-5 shrink-0 text-ink-muted transition-transform" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                </svg>
              </button>
              <div id={`faq-panel-${i}`} class="hidden px-5 pb-4 text-body" role="region" aria-labelledby={`faq-btn-${i}`}>
                {f.a}
              </div>
            </div>
          ))
        }
      </div>

      <aside class="mt-8 rounded-[var(--radius-md)] border border-border bg-soft p-5 sm:p-6">
        <h3 class="text-base font-bold text-ink">Transparencia</h3>
        <ul class="mt-4 grid gap-5 text-sm leading-relaxed text-ink-muted sm:grid-cols-2">
          <li>
            <p class="font-semibold text-ink">Fuente del banco</p>
            <p class="mt-1">
              Balotarios públicos en{' '}
              <a href={site.sources.balotarios} target="_blank" rel="noopener noreferrer">gob.pe</a>
            </p>
          </li>
          <li>
            <p class="font-semibold text-ink">Última revisión</p>
            <p class="mt-1">{reviewDate}</p>
          </li>
          <li>
            <p class="font-semibold text-ink">Metodología</p>
            <p class="mt-1">
              <a href="/acerca">Cómo preparamos las explicaciones</a>
            </p>
          </li>
          <li>
            <p class="font-semibold text-ink">Independiente</p>
            <p class="mt-1">Plataforma independiente de preparación. No somos un sitio oficial del Estado.</p>
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  })} />

  <script>
    document.querySelectorAll('.faq-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        const button = btn as HTMLButtonElement;
        const panelId = button.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        panel?.classList.toggle('hidden', open);
        button.querySelector('.faq-chevron')?.classList.toggle('rotate-180', !open);
      });
    });

    try {
      const raw = localStorage.getItem('practicabrevete.progress.v1');
      const hint = document.getElementById('home-repaso-hint');
      const desc = document.getElementById('home-repaso-desc');
      const card = document.getElementById('home-repaso-card') as HTMLAnchorElement | null;
      const cta = document.getElementById('home-repaso-cta') as HTMLAnchorElement | null;

      if (raw) {
        const data = JSON.parse(raw);
        const errors = Array.isArray(data.errores) ? data.errores.length : 0;
        if (errors > 0) {
          if (hint) {
            hint.textContent = `Tienes ${errors} pregunta${errors === 1 ? '' : 's'} para repasar.`;
          }
          if (desc) {
            desc.textContent = `${errors} pregunta${errors === 1 ? '' : 's'} listas para repasar.`;
          }
        } else {
          if (card) card.href = '/practica/senales';
          if (cta) {
            cta.href = '/practica/senales';
            cta.textContent = 'Empezar a practicar';
          }
        }
      } else {
        if (card) card.href = '/practica/senales';
        if (cta) {
          cta.href = '/practica/senales';
          cta.textContent = 'Empezar a practicar';
        }
      }
    } catch {
      /* ignore */
    }
  </script>
</BaseLayout>
