---
import BaseLayout from '../layouts/BaseLayout.astro';
import PreviewPractice from '../components/quiz/PreviewPractice';
import TopicIcon from '../components/ui/TopicIcon.astro';
import { site } from '../config/site';
import { temas } from '../data/temas';
import { getPublishedQuestions } from '../lib/questions';

const preview =
  getPublishedQuestions().find((q) => q.id === 'a-i-006') ?? getPublishedQuestions()[0];

const previewPayload = preview
  ? {
      id: preview.id,
      categoria: preview.categoria,
      tema: preview.tema,
      enunciado: preview.enunciado,
      opciones: preview.opciones,
      correcta: preview.correcta,
      imagen: preview.imagen,
      explicacion: preview.explicacion,
      slug: preview.slug,
    }
  : null;

const faqs = [
  {
    q: '¿Cuántas preguntas tiene el examen de brevete?',
    a: `El examen de reglas de tránsito tiene ${site.examRules.questionCount} preguntas de selección múltiple. Para aprobar necesitas al menos ${site.examRules.passScore} correctas, según la orientación publicada en gob.pe.`,
  },
  {
    q: '¿Cuánto tiempo dura el examen de reglas de tránsito?',
    a: `La prueba oficial dura hasta ${site.examRules.timeLimitMinutes} minutos. En nuestro simulacro puedes activar o desactivar el temporizador.`,
  },
  {
    q: '¿Las preguntas son las del balotario oficial?',
    a: 'Sí: el banco se construye a partir de los PDFs públicos de balotarios publicados en gob.pe. Las explicaciones las redactamos nosotros y las marcamos como “revisar” hasta validarlas.',
  },
  {
    q: '¿Este sitio es oficial?',
    a: 'No. Practica Brevete es una plataforma independiente de preparación. No representamos a ninguna entidad del Estado ni usamos logos oficiales.',
  },
  {
    q: '¿Necesito crear una cuenta?',
    a: 'No. El progreso y el repaso de errores se guardan solo en tu navegador (localStorage), en este dispositivo.',
  },
  {
    q: '¿El simulacro es gratis?',
    a: 'Sí. Puedes practicar sin pagar y sin crear una cuenta.',
  },
];

const guias = [
  {
    href: '/guias/como-sacar-brevete-a-i',
    title: 'Cómo sacar el brevete A-I',
    desc: 'Orden general del proceso, requisitos tipicos y enlaces a fuentes oficiales.',
    label: 'Proceso',
  },
  {
    href: '/guias/senales-de-transito',
    title: 'Señales de tránsito explicadas',
    desc: 'Reglamentarias, semáforos y marcas viales con foco en el examen.',
    label: 'Señales',
  },
  {
    href: '/guias/prioridad-de-paso-y-rotondas',
    title: 'Prioridad de paso y rotondas',
    desc: 'Quién pasa primero en cruces, emergencias y glorietas.',
    label: 'Prioridad',
  },
  {
    href: '/guias/errores-comunes-examen',
    title: 'Errores más comunes',
    desc: 'Fallos frecuentes y cómo corregirlos con práctica deliberada.',
    label: 'Examen',
  },
  {
    href: '/guias/como-estudiar-en-7-dias',
    title: 'Cómo estudiar en 7 días',
    desc: 'Plan semanal con simulacros, temas y repaso de errores.',
    label: 'Estudio',
  },
  {
    href: '/guias/examen-de-manejo-practico',
    title: 'Examen de manejo práctico',
    desc: 'En qué fijarse además del teórico de reglas de tránsito.',
    label: 'Práctico',
  },
];

const reviewDate = new Date(`${site.lastContentReview}T12:00:00`).toLocaleDateString('es-PE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${site.name}: simulador del examen de reglas de tránsito`}
  description={site.description}
>
  <!-- Hero -->
  <section class="border-b border-border bg-bg">
    <div class="container-page grid items-start gap-10 py-12 sm:py-16 lg:grid-cols-2 lg:gap-12 lg:py-20">
      <div>
        <p class="badge">Disponible para categoría A-I</p>
        <h1 class="heading-hero mt-4">Prepárate para tu examen de reglas de tránsito</h1>
        <p class="text-body mt-4 max-w-xl">
          Practica a tu ritmo, entiende cada respuesta y repasa tus errores antes de rendir.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="/simulacro/a-i" class="btn-primary">Empezar simulacro A-I</a>
          <a href="/practica/senales" class="btn-secondary">Practicar por tema</a>
        </div>
        <p class="text-support mt-4">Sin registro · Progreso guardado en este dispositivo</p>
      </div>

      <div>
        {
          previewPayload ? (
            <PreviewPractice client:load question={previewPayload} />
          ) : (
            <div class="card-surface p-6">
              <p class="badge">Así puedes practicar</p>
              <p class="mt-4 text-body">Elige un tema o inicia un simulacro para comenzar.</p>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="border-b border-border bg-surface">
    <div class="container-page py-8 sm:py-10">
      <ul class="grid gap-6 text-sm text-ink-muted sm:grid-cols-2 lg:grid-cols-4">
        <li>
          <p class="font-semibold text-ink">Fuente del banco</p>
          <p class="mt-1">
            Balotarios públicos en{' '}
            <a href={site.sources.balotarios} target="_blank" rel="noopener noreferrer">gob.pe</a>
          </p>
        </li>
        <li>
          <p class="font-semibold text-ink">Última revisión</p>
          <p class="mt-1">{reviewDate}</p>
        </li>
        <li>
          <p class="font-semibold text-ink">Metodología</p>
          <p class="mt-1">
            <a href="/acerca">Cómo preparamos las explicaciones</a>
          </p>
        </li>
        <li>
          <p class="font-semibold text-ink">Independiente</p>
          <p class="mt-1">Plataforma independiente de preparación. No somos un sitio oficial del Estado.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- Learning modes -->
  <section class="section-y">
    <div class="container-page">
      <h2 class="heading-section">Elige cómo quieres estudiar</h2>
      <p class="text-body mt-3 max-w-2xl">Tres formas claras de preparar tu examen de reglas.</p>
      <ul class="mt-8 grid gap-4 md:grid-cols-3">
        <li class="card-surface flex flex-col p-6">
          <h3 class="heading-card">Simulacro</h3>
          <p class="text-body mt-2 flex-1">Evalúa tu preparación en una sesión completa.</p>
          <a href="/simulacro/a-i" class="btn-primary mt-6 w-full">Empezar simulacro</a>
        </li>
        <li class="card-surface flex flex-col p-6">
          <h3 class="heading-card">Práctica por tema</h3>
          <p class="text-body mt-2 flex-1">Refuerza un tema con explicaciones.</p>
          <a href="/practica/senales" class="btn-secondary mt-6 w-full">Elegir tema</a>
        </li>
        <li class="card-surface flex flex-col p-6">
          <h3 class="heading-card">Repaso de errores</h3>
          <p class="text-body mt-2 flex-1">Vuelve sobre lo que necesitas mejorar.</p>
          <a href="/repaso" class="btn-secondary mt-6 w-full">Repasar errores</a>
          <p class="text-support mt-3" id="home-repaso-hint">
            Aquí aparecerán las preguntas que respondas incorrectamente.
          </p>
        </li>
      </ul>
      <div id="home-continuar" class="mt-6 hidden">
        <a href="/practica/senales" class="btn-text" id="home-continuar-link">Continuar practicando</a>
      </div>
    </div>
  </section>

  <!-- Topics -->
  <section class="section-y border-y border-border bg-surface">
    <div class="container-page">
      <h2 class="heading-section">Temas para practicar</h2>
      <p class="text-body mt-3 max-w-2xl">Elige un bloque del balotario y practica con feedback inmediato.</p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          temas.map((t) => (
            <li>
              <a
                href={`/practica/${t.slug}`}
                class="card-surface group flex h-full flex-col p-5 no-underline transition-colors hover:border-brand hover:no-underline focus-visible:border-brand"
              >
                <span class="flex h-11 w-11 items-center justify-center rounded-[12px] bg-brand-soft text-brand">
                  <TopicIcon name={t.icon} />
                </span>
                <h3 class="heading-card mt-4">{t.nombre}</h3>
                <p class="text-body mt-2 flex-1 text-[15px]">{t.descripcion}</p>
                <span class="mt-4 text-sm font-semibold text-brand group-hover:underline">{t.accion}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Guides -->
  <section class="section-y">
    <div class="container-page">
      <h2 class="heading-section">Guías para sacar el brevete</h2>
      <p class="text-body mt-3 max-w-2xl">
        Lecturas propias, con respuesta directa al inicio y fuentes citadas.
      </p>
      <ul class="mt-8 divide-y divide-border border-y border-border">
        {
          guias.map((g) => (
            <li>
              <a
                href={g.href}
                class="group flex flex-col gap-1 py-5 no-underline hover:no-underline sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
              >
                <div class="min-w-0">
                  <span class="badge-accent text-xs">{g.label}</span>
                  <h3 class="mt-2 text-lg font-semibold text-ink group-hover:text-brand">{g.title}</h3>
                  <p class="text-support mt-1 max-w-xl">{g.desc}</p>
                </div>
                <span class="shrink-0 text-sm font-semibold text-brand">Leer guía →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-y border-t border-border bg-surface pb-12 sm:pb-14">
    <div class="container-page max-w-3xl">
      <h2 class="heading-section">Preguntas frecuentes</h2>
      <div class="mt-8 divide-y divide-border rounded-[16px] border border-border bg-bg">
        {
          faqs.map((f, i) => (
            <div class="px-1">
              <button
                type="button"
                class="faq-trigger flex min-h-14 w-full items-center justify-between gap-4 px-4 py-4 text-left text-base font-semibold text-ink"
                aria-expanded="false"
                aria-controls={`faq-panel-${i}`}
                id={`faq-btn-${i}`}
              >
                <span>{f.q}</span>
                <svg class="faq-chevron h-5 w-5 shrink-0 text-ink-muted transition-transform" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                </svg>
              </button>
              <div id={`faq-panel-${i}`} class="hidden px-4 pb-4 text-body" role="region" aria-labelledby={`faq-btn-${i}`}>
                {f.a}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  })} />

  <script>
    document.querySelectorAll('.faq-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        const button = btn as HTMLButtonElement;
        const panelId = button.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        panel?.classList.toggle('hidden', open);
        button.querySelector('.faq-chevron')?.classList.toggle('rotate-180', !open);
      });
    });

    try {
      const raw = localStorage.getItem('practicabrevete.progress.v1');
      if (raw) {
        const data = JSON.parse(raw);
        const hasHistory = Array.isArray(data.historial) && data.historial.length > 0;
        const hasPractice =
          data.practicaPorTema &&
          Object.values(data.practicaPorTema).some((t: { vistas?: number }) => (t?.vistas ?? 0) > 0);
        const errors = Array.isArray(data.errores) ? data.errores.length : 0;
        const hint = document.getElementById('home-repaso-hint');
        if (errors > 0 && hint) {
          hint.textContent = `Tienes ${errors} pregunta${errors === 1 ? '' : 's'} para repasar.`;
        }
        if (hasHistory || hasPractice) {
          document.getElementById('home-continuar')?.classList.remove('hidden');
        }
      }
    } catch {
      /* ignore */
    }
  </script>
</BaseLayout>
