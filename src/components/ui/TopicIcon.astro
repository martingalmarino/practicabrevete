---
interface Props {
  name: 'sign' | 'priority' | 'speed' | 'docs' | 'aid' | 'wrench';
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
  {
    name === 'sign' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M8 12h8M12 8v8" stroke-linecap="round" />
      </>
    )
  }
  {
    name === 'priority' && (
      <>
        <path d="M12 3l8 14H4L12 3z" stroke-linejoin="round" />
        <path d="M12 10v3M12 16h.01" stroke-linecap="round" />
      </>
    )
  }
  {
    name === 'speed' && (
      <>
        <path d="M4 14a8 8 0 0116 0" stroke-linecap="round" />
        <path d="M12 14l4-4" stroke-linecap="round" />
        <circle cx="12" cy="14" r="1.5" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'docs' && (
      <>
        <path d="M7 3h7l4 4v14H7V3z" stroke-linejoin="round" />
        <path d="M14 3v4h4M9 12h6M9 16h6" stroke-linecap="round" />
      </>
    )
  }
  {
    name === 'aid' && (
      <>
        <rect x="3" y="7" width="18" height="12" rx="2" />
        <path d="M12 10v6M9 13h6" stroke-linecap="round" />
      </>
    )
  }
  {
    name === 'wrench' && (
      <path
        d="M14.7 6.3a4 4 0 00-5.6 5.6L4 17l3 3 5.1-5.1a4 4 0 005.6-5.6l-2.5 2.5-3-3 2.5-2.5z"
        stroke-linejoin="round"
      />
    )
  }
</svg>
