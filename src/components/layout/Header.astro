---
import Logo from '../brand/Logo.astro';

const pathname = Astro.url.pathname;

const links = [
  { href: '/practica/senales/', label: 'Practicar', match: '/practica' },
  { href: '/simulacro/', label: 'Simulacro', match: '/simulacro' },
  { href: '/guias/como-sacar-brevete-a-i/', label: 'Guías', match: '/guias' },
];
---

<header
  id="site-header"
  class="site-header sticky top-0 z-40 border-b border-border bg-surface"
>
  <div
    class="container-wide grid h-[68px] grid-cols-[1fr_auto] items-center gap-3 md:h-20 md:grid-cols-[1fr_auto_1fr]"
  >
    <div class="min-w-0 justify-self-start">
      <Logo variant="full" size="header" />
    </div>

    <nav class="hidden items-center gap-2 md:flex" aria-label="Principal">
      {
        links.map((link) => {
          const sectionActive = pathname.startsWith(link.match);
          const isCurrentPage = pathname === link.href;
          return (
            <a
              href={link.href}
              class:list={[
                'inline-flex min-h-11 items-center rounded-[12px] px-4 text-base font-semibold no-underline transition-colors hover:no-underline',
                sectionActive
                  ? 'bg-brand-soft font-bold text-brand'
                  : 'text-ink-muted hover:bg-brand-soft hover:text-brand',
              ]}
              aria-current={isCurrentPage ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center justify-end gap-2 justify-self-end">
      <a href="/simulacro/a-i/" class="btn-header hidden md:inline-flex">
        Empezar simulacro
      </a>

      <button
        type="button"
        id="nav-toggle"
        class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-[12px] border border-border bg-surface text-ink md:hidden"
        aria-expanded="false"
        aria-controls="nav-mobile"
        aria-label="Abrir menú"
      >
        <svg id="nav-icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        <svg id="nav-icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="nav-mobile" class="border-t border-border bg-surface md:hidden" hidden>
    <nav class="container-wide flex flex-col gap-1 py-3" aria-label="Menú móvil">
      {
        links.map((link) => {
          const sectionActive = pathname.startsWith(link.match);
          const isCurrentPage = pathname === link.href;
          return (
            <a
              href={link.href}
              class:list={[
                'inline-flex min-h-12 items-center rounded-[12px] px-4 text-base font-semibold no-underline hover:no-underline',
                sectionActive
                  ? 'bg-brand-soft font-bold text-brand'
                  : 'text-ink hover:bg-brand-soft hover:text-brand',
              ]}
              aria-current={isCurrentPage ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
      <a href="/simulacro/a-i/" class="btn-primary mt-2 w-full">Empezar simulacro</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-mobile');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  function setScrolled() {
    header?.classList.toggle('is-scrolled', window.scrollY > 4);
  }

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    panel.hidden = !open;
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  }

  setScrolled();
  window.addEventListener('scroll', setScrolled, { passive: true });

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!open);
  });

  panel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
