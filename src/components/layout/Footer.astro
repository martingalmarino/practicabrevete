---
import { site } from '../../config/site';
import Logo from '../brand/Logo.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-footer">
  <div class="container-wide grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4 lg:py-14">
    <div class="lg:col-span-1">
      <Logo variant="full" class="mb-3" />
      <p class="mt-2 text-sm text-ink-muted">Prepárate para tu examen de reglas de tránsito con confianza.</p>
      <p class="mt-4 text-sm leading-relaxed text-ink-muted">
        Plataforma independiente de preparación. No somos un sitio oficial del Estado.
      </p>
    </div>

    <div>
      <p class="text-sm font-bold text-ink">Practicar</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-ink-muted no-underline hover:text-ink hover:underline" href="/simulacro/a-i">Simulacro A-I</a></li>
        <li><a class="text-ink-muted no-underline hover:text-ink hover:underline" href="/practica/senales">Práctica por tema</a></li>
        <li><a class="text-ink-muted no-underline hover:text-ink hover:underline" href="/repaso">Repaso de errores</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-bold text-ink">Guías</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-ink-muted no-underline hover:text-ink hover:underline" href="/guias/como-sacar-brevete-a-i">Cómo sacar el brevete</a></li>
        <li><a class="text-ink-muted no-underline hover:text-ink hover:underline" href="/guias/senales-de-transito">Señales de tránsito</a></li>
        <li><a class="text-ink-muted no-underline hover:text-ink hover:underline" href="/guias/como-estudiar-en-7-dias">Estudiar en 7 días</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-bold text-ink">Acerca y legal</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-ink-muted no-underline hover:text-ink hover:underline" href="/acerca">Acerca</a></li>
        <li><a class="text-ink-muted no-underline hover:text-ink hover:underline" href="/contacto">Contacto</a></li>
        <li><a class="text-ink-muted no-underline hover:text-ink hover:underline" href="/privacidad">Privacidad</a></li>
        <li><a class="text-ink-muted no-underline hover:text-ink hover:underline" href="/terminos">Términos</a></li>
        <li><a class="text-ink-muted no-underline hover:text-ink hover:underline" href="/aviso-legal">Aviso legal</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container-wide flex flex-col gap-2 py-4 text-xs text-ink-muted sm:flex-row sm:justify-between">
      <p>© {year} {site.name}</p>
      <p>
        <a class="text-ink-muted no-underline hover:text-ink hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </div>
</footer>
