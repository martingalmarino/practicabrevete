---
import { site } from '../../config/site';
import Logo from '../brand/Logo.astro';

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-brand-hover bg-footer text-white">
  <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-1">
      <Logo variant="full" inverted class="mb-3" />
      <p class="mt-2 text-sm text-white/75">Prepárate para tu examen de reglas de tránsito con confianza.</p>
      <p class="mt-4 text-sm leading-relaxed text-white/65">
        Plataforma independiente de preparación. No somos un sitio oficial del Estado.
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold text-accent">Practicar</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-white/80 no-underline hover:text-white hover:underline" href="/simulacro/a-i">Simulacro A-I</a></li>
        <li><a class="text-white/80 no-underline hover:text-white hover:underline" href="/practica/senales">Práctica por tema</a></li>
        <li><a class="text-white/80 no-underline hover:text-white hover:underline" href="/repaso">Repaso de errores</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-accent">Guías</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-white/80 no-underline hover:text-white hover:underline" href="/guias/como-sacar-brevete-a-i">Cómo sacar el brevete</a></li>
        <li><a class="text-white/80 no-underline hover:text-white hover:underline" href="/guias/senales-de-transito">Señales de tránsito</a></li>
        <li><a class="text-white/80 no-underline hover:text-white hover:underline" href="/guias/como-estudiar-en-7-dias">Estudiar en 7 días</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-accent">Acerca y legal</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-white/80 no-underline hover:text-white hover:underline" href="/acerca">Acerca</a></li>
        <li><a class="text-white/80 no-underline hover:text-white hover:underline" href="/contacto">Contacto</a></li>
        <li><a class="text-white/80 no-underline hover:text-white hover:underline" href="/privacidad">Privacidad</a></li>
        <li><a class="text-white/80 no-underline hover:text-white hover:underline" href="/terminos">Términos</a></li>
        <li><a class="text-white/80 no-underline hover:text-white hover:underline" href="/aviso-legal">Aviso legal</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-4 text-xs text-white/55 sm:flex-row sm:justify-between">
      <p>© {year} {site.name}</p>
      <p>
        <a class="text-white/70 no-underline hover:text-white hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </div>
</footer>
