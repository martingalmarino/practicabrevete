---
import ProductShowcase from './ProductShowcase.astro';
import { site } from '../../config/site';

const total = site.examRules.questionCount;
const pass = site.examRules.passScore;
---

<div aria-hidden="true">
  <ProductShowcase tone="bg-peach" class="mx-auto lg:mx-0">
    <div class="flex items-center justify-between gap-2">
      <p class="text-xs font-bold uppercase tracking-wide text-ink-muted">Simulacro · Ejemplo</p>
      <span class="rounded-[10px] bg-soft px-2 py-0.5 text-xs font-semibold text-ink-muted">
        Resultado
      </span>
    </div>
    <p class="mt-4 text-2xl font-extrabold tracking-tight text-ink">{pass} / {total}</p>
    <p class="mt-1 text-sm font-semibold text-success">Umbral de práctica alcanzado</p>
    <div class="mt-4 h-2 overflow-hidden rounded-full bg-border">
      <div class="h-full rounded-full bg-success" style={`width: ${(pass / total) * 100}%`}></div>
    </div>
    <ul class="mt-5 space-y-2 text-sm">
      <li class="flex justify-between rounded-[var(--radius-sm)] border border-border px-3 py-2.5">
        <span class="text-ink-muted">Señales</span>
        <span class="font-semibold text-ink">Bien</span>
      </li>
      <li class="flex justify-between rounded-[var(--radius-sm)] border border-border px-3 py-2.5">
        <span class="text-ink-muted">Prioridad</span>
        <span class="font-semibold text-ink">A reforzar</span>
      </li>
      <li class="flex justify-between rounded-[var(--radius-sm)] border border-border px-3 py-2.5">
        <span class="text-ink-muted">Documentos</span>
        <span class="font-semibold text-ink">Bien</span>
      </li>
    </ul>
    <p class="mt-4 text-xs text-ink-muted">Ejemplo ilustrativo · no es tu resultado</p>
  </ProductShowcase>
</div>
