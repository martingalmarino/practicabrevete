---
import { site } from '../../config/site';

interface Props {
  /** full = marca + nombre; mark = solo símbolo */
  variant?: 'full' | 'mark';
  /** Para fondos oscuros (footer) */
  inverted?: boolean;
  class?: string;
}

const { variant = 'full', inverted = false, class: className = '' } = Astro.props;
const label = `${site.name} — inicio`;
---

<a
  href="/"
  class:list={[
    'group inline-flex min-h-11 items-center gap-2.5 no-underline hover:no-underline',
    className,
  ]}
  aria-label={label}
>
  <span class="relative inline-flex h-9 w-9 shrink-0 sm:h-10 sm:w-10" aria-hidden="true">
    <svg viewBox="0 0 48 48" class="h-full w-full" xmlns="http://www.w3.org/2000/svg" role="img">
      <title>{site.name}</title>
      <!-- Base -->
      <rect width="48" height="48" rx="14" fill={inverted ? '#FFFFFF' : '#C8102E'} />
      <!-- Anillo suave -->
      <circle
        cx="24"
        cy="24"
        r="15"
        fill="none"
        stroke={inverted ? '#C8102E' : '#FFFFFF'}
        stroke-width="1.5"
        opacity="0.28"
      />
      <!-- Camino / carriles que convergen (progreso + conducción) -->
      <path
        d="M17.5 35.5c1.2-8.2 3.6-14.2 6.5-20.2"
        fill="none"
        stroke={inverted ? '#C8102E' : '#FFFFFF'}
        stroke-width="2.75"
        stroke-linecap="round"
      />
      <path
        d="M30.5 35.5c-1.2-8.2-3.6-14.2-6.5-20.2"
        fill="none"
        stroke={inverted ? '#C8102E' : '#FFFFFF'}
        stroke-width="2.75"
        stroke-linecap="round"
      />
      <!-- Meta / check discreto -->
      <circle cx="24" cy="12.5" r="3.1" fill={inverted ? '#C8102E' : '#FFFFFF'} />
      <path
        d="M22.2 12.4l1.2 1.3 2.6-2.8"
        fill="none"
        stroke={inverted ? '#FFFFFF' : '#C8102E'}
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>

  {
    variant === 'full' && (
      <span class="flex min-w-0 flex-col leading-none">
        <span
          class:list={[
            'text-[0.95rem] font-semibold tracking-[-0.02em] sm:text-[1.05rem]',
            inverted ? 'text-white group-hover:text-white/90' : 'text-ink group-hover:text-brand',
          ]}
        >
          Practica <span class="font-bold">Brevete</span>
        </span>
        <span
          class:list={[
            'mt-0.5 hidden text-[0.65rem] font-medium tracking-[0.04em] uppercase sm:block',
            inverted ? 'text-white/55' : 'text-ink-muted',
          ]}
        >
          Examen de reglas
        </span>
      </span>
    )
  }
</a>
