---
import { site } from '../../config/site';

interface Props {
  variant?: 'full' | 'mark';
  /** Tamaño del lockup: header (default) o footer */
  size?: 'header' | 'footer';
  inverted?: boolean;
  class?: string;
}

const { variant = 'full', size = 'header', inverted = false, class: className = '' } = Astro.props;

const BRAND = '#4F46E5';
const fg = inverted ? BRAND : '#FFFFFF';
const bg = inverted ? '#FFFFFF' : BRAND;

const isFooter = size === 'footer';
---

<a
  href="/"
  class:list={[
    'inline-flex items-center no-underline hover:no-underline',
    isFooter ? 'gap-2.5' : 'gap-3',
    className,
  ]}
  aria-label={`${site.name} — Inicio`}
>
  <span
    class:list={[
      'relative inline-flex shrink-0',
      isFooter ? 'h-9 w-9' : 'h-9 w-9 md:h-12 md:w-12',
    ]}
    aria-hidden="true"
  >
    <svg viewBox="0 0 48 48" class="h-full w-full" xmlns="http://www.w3.org/2000/svg" focusable="false">
      <rect width="48" height="48" rx="14" fill={bg} />
      <circle cx="24" cy="24" r="13.25" fill="none" stroke={fg} stroke-width="3.4" />
      <circle cx="24" cy="24" r="4" fill={fg} />
      <path
        d="M11.2 24H20M28 24h8.8M24 28v9.5"
        stroke={fg}
        stroke-width="3.2"
        stroke-linecap="round"
      />
    </svg>
  </span>

  {
    variant === 'full' && (
      <span class="flex min-w-0 flex-col leading-none">
        <span
          class:list={[
            'tracking-[-0.02em] text-ink',
            isFooter
              ? 'text-[1.125rem]'
              : 'text-[1.1875rem] md:text-[1.5rem]',
          ]}
        >
          <span class="font-semibold">Practica</span>{' '}
          <span class="font-extrabold">Brevete</span>
        </span>
        <span
          class:list={[
            'font-medium text-ink-muted',
            isFooter
              ? 'mt-1 hidden text-[11px] sm:block'
              : 'mt-1 hidden text-xs md:block',
          ]}
        >
          Prepárate para conducir
        </span>
      </span>
    )
  }
</a>
